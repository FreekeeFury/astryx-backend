const express = require('express');
const cors = require('cors');
const fs = require('fs');
const path = require('path');

const app = express();
app.use(express.json());
app.use(cors()); // Allows your website to fetch data from any domain

const SECRET_KEY = "AstryxSecretKey123";
const DATA_FILE = path.join(__dirname, 'data.json');

// Initialize data.json if it doesn't exist
if (!fs.existsSync(DATA_FILE)) {
    fs.writeFileSync(DATA_FILE, JSON.stringify([], null, 2));
}

// POST endpoint for your WispByte Discord Bot
app.post('/update', (req, res) => {
    const key = req.query.key;
    if (key !== SECRET_KEY) {
        return res.status(401).json({ status: "error", message: "Unauthorized key" });
    }

    const payload = req.body;
    if (!payload || !payload.username) {
        return res.status(400).json({ status: "error", message: "Invalid payload" });
    }

    let currentData = [];
    try {
        currentData = JSON.parse(fs.readFileSync(DATA_FILE, 'utf8'));
    } catch (e) {
        currentData = [];
    }

    const player = String(payload.username).trim();
    const mode = String(payload.mode).toLowerCase().trim();
    const tier = String(payload.tier).trim();
    const region = payload.region ? String(payload.region).trim() : 'AS';

    let found = false;
    for (let p of currentData) {
        if (p.username.toLowerCase() === player.toLowerCase()) {
            p.username = player;
            p.region = region;
            if (!p.tiers) p.tiers = {};
            p.tiers[mode] = tier;
            found = true;
            break;
        }
    }

    if (!found) {
        currentData.push({
            username: player,
            region: region,
            tiers: { [mode]: tier }
        });
    }

    try {
        fs.writeFileSync(DATA_FILE, JSON.stringify(currentData, null, 2));
        return res.json({ status: "success", message: "Updated" });
    } catch (e) {
        return res.status(500).json({ status: "error", message: "Write failed" });
    }
});

// GET endpoint for your index2.html website to read rankings
app.get('/data.json', (req, res) => {
    res.sendFile(DATA_FILE);
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`Backend running on port ${PORT}`));